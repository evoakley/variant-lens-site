---
const { heading = "Make every variant easier to understand", text = "Choose which images belong to each variant and keep unrelated images out of the way.", buttonLabel = "View VariantLens on Shopify" } = Astro.props;
---
<section class="cta" id="install"><h2>{heading}</h2><p>{text}</p><a class="button" href="https://apps.shopify.com/variantlens">{buttonLabel}</a></section>
