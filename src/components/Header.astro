---
const { variant = "default" } = Astro.props;
const headerClass = variant === "floating" ? "site-header site-header--floating" : "site-header";
const installClass = variant === "floating" ? "button nav-install-button" : "button";
---
<header class={headerClass}><nav class="shell nav" aria-label="Main navigation"><a class="brand" href="/" aria-label="VariantLens home"><img class="brand-mark" src="/assets/brand/variantlens-mark.png" alt="" width="1200" height="1200"/><img class="brand-wordmark" src="/assets/brand/variantlens-wordmark.png" alt="" width="394" height="128"/></a><div class="nav-links"><a class="nav-text-link" href="/pricing"><span>Pricing</span></a><a class="nav-text-link" href="/support"><span>Support</span></a><a class={installClass} href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a></div></nav></header>

<style>
  .site-header {
    background: rgba(241, 241, 241, .97);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header--floating {
    position: sticky;
    top: 14px;
    width: min(calc(100% - 32px), 1180px);
    margin: 14px auto -83px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .9);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255, 255, 255, .82), rgba(237, 237, 247, .72));
    box-shadow:
      0 16px 40px rgba(34, 37, 58, .14),
      inset 0 1px 0 rgba(255, 255, 255, .95),
      inset 0 -1px 0 rgba(92, 101, 150, .08);
  }

  .site-header--floating::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image:
      linear-gradient(110deg, rgba(255, 255, 255, .3), transparent 42%),
      radial-gradient(circle, rgba(74, 82, 126, .2) .55px, transparent .7px);
    background-size: 100% 100%, 4px 4px;
    pointer-events: none;
  }

  .site-header--floating .nav {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 68px;
    padding-inline: 22px;
  }

  .nav-install-button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    contain: paint;
    border-width: 3px;
    background: #fff;
    color: #fff;
    transform: translateZ(0);
    backface-visibility: hidden;
    transition: color .2s ease;
  }

  .nav-install-button::before {
    content: "";
    position: absolute;
    z-index: 0;
    width: 120%;
    height: 165%;
    left: -10%;
    top: -32%;
    border-radius: 48% / 28%;
    background: var(--accent);
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    will-change: transform;
    transition: transform .36s cubic-bezier(.16, 1, .3, 1);
  }

  .nav-install-button:hover,
  .nav-install-button:focus-visible {
    border-color: var(--accent);
    background: #fff;
    color: var(--ink);
  }

  .nav-install-button:hover::before,
  .nav-install-button:focus-visible::before {
    transform: translate3d(0, -86%, 0);
  }

  .nav-install-button span {
    position: relative;
    z-index: 1;
  }

  .site-header--floating .nav-text-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 8px 11px;
    border-radius: 8px;
  }

  .site-header--floating .nav-text-link::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: rgba(98, 112, 175, .07);
    pointer-events: none;
    transform: translate3d(0, 105%, 0);
    transition: transform .28s cubic-bezier(.22, 1, .36, 1);
  }

  .site-header--floating .nav-text-link:hover::before,
  .site-header--floating .nav-text-link:focus-visible::before {
    transform: translate3d(0, 0, 0);
  }

  .site-header--floating .nav-text-link span {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 760px) {
    .site-header--floating {
      top: 8px;
      width: calc(100% - 16px);
      margin: 8px auto -73px;
      border-radius: 15px;
    }

    .site-header--floating .nav {
      min-height: 64px;
      padding-inline: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-install-button::before { transition-duration: .01ms; }
    .site-header--floating .nav-text-link::before { transition-duration: .01ms; }
  }
</style>
