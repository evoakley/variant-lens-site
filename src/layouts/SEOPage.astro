---
import BaseLayout from "./BaseLayout.astro";
import CTA from "../components/CTA.astro";
const { title, description, eyebrow, heading, intro } = Astro.props;
---
<BaseLayout {title} {description}><header class="page-hero"><div class="shell"><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p>{intro}</p></div></header><article class="section"><div class="shell content"><slot/></div></article><CTA/></BaseLayout>
