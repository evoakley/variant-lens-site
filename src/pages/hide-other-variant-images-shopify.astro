---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import WaveDivider from "../components/WaveDivider.astro";

const title = "Hide Other Variant Images in Shopify | VariantLens";
const description = "Hide images that belong to other Shopify variants. VariantLens gives you manual control over each variant’s gallery, image order and cover image.";
const canonicalUrl = "https://variantlens.app/hide-other-variant-images-shopify/";
const faqs = [
  { question: "Can Shopify hide images that belong to other variants?", answer: "Yes. VariantLens lets you assign existing Shopify product media to individual variants so the storefront gallery can show the images relevant to the shopper’s current selection." },
  { question: "Does VariantLens assign images automatically?", answer: "No. Assignment is manual. You decide which images belong to each variant, their order and which image appears first." },
  { question: "Can I control the order of each variant’s images?", answer: "Yes. You can reorder assigned images independently for each variant. The first assigned image becomes that variant’s cover image." },
  { question: "Can I test VariantLens on one product?", answer: "Yes. The Free plan supports one active storefront product at a time with no variant limit." },
  { question: "Does VariantLens remove my original Shopify product media?", answer: "No. Your original product media remains attached to the Shopify product. VariantLens controls which assigned images shoppers see for each selection." },
  { question: "Do I need to edit my theme code?", answer: "No manual theme-code editing is required. VariantLens runs through its Shopify app embed." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="hide-hero"><div class="shell hide-hero__grid">
    <div class="hide-hero__copy"><p class="eyebrow">Shopify variant gallery control</p><h1>Hide other variant images in Shopify</h1><p>Choose which product images belong to each variant, then keep other colours and styles out of that variant’s gallery.</p><div class="hide-proof" role="list"><span role="listitem">Manual control</span><span role="listitem">No coding</span><span role="listitem">Start free</span></div><div class="actions hide-actions"><a class="button hide-button" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a class="button secondary hide-button hide-button--secondary" href="#how-it-works"><span>See how it works</span></a></div></div>
    <div class="gallery-comparison">
      <img src="/assets/brand/variant-gallery-before-after.png" width="1696" height="951" alt="Before and after storefront galleries: mixed colour images are replaced by images matching the selected blue variant" loading="eager" decoding="async" />
    </div>
  </div></section>

  <section class="confusion-section"><div class="shell confusion-grid"><div><p class="eyebrow">The problem</p><h2>Shopify keeps all media visible even if a variant is selected.</h2></div><div class="confusion-copy"><p>A product may contain images for several colours or styles in the same media gallery. Depending on the theme and setup, selecting a variant doesn’t necessarily give that variant its own clean image set - so shoppers can still see media belonging to other options.</p></div></div></section>

  <section class="focus-section"><div class="shell focus-grid"><div class="focus-copy"><p class="eyebrow">A focused selection</p><h2>One selected variant. One relevant gallery.</h2><p>VariantLens uses the image assignments you make to keep each storefront selection focused on its own media.</p><a href="/show-only-selected-variant-images-shopify/">Read the selected variant image guide →</a></div><div class="variant-gallery-image"><img src="/assets/brand/separate-variant-galleries.png" width="1688" height="941" alt="Separate product image galleries for Blue, Green and Sand backpack variants" loading="lazy" decoding="async" /></div></div></section>

  <div class="control-curve control-curve--top" aria-hidden="true"><svg viewBox="0 0 1440 24" preserveAspectRatio="none"><path fill="#22242e" d="M0 24V16Q720 2 1440 12V24Z"></path></svg></div>
  <section class="control-section"><div class="shell control-grid"><div><p class="eyebrow">Merchant controlled</p><h2>No guessing. You choose every image.</h2></div><div class="control-points"><article><span>01</span><h3>Assign every image</h3><p>Choose exactly which existing Shopify media belongs to each variant.</p></article><article><span>02</span><h3>Set the gallery order</h3><p>Choose the cover image and arrange what shoppers see next.</p></article><article><span>03</span><h3>Check it on your store</h3><p>Save the assignment, switch variants and verify the result.</p></article></div></div></section>
  <div class="control-curve control-curve--bottom" aria-hidden="true"><svg viewBox="0 0 1440 24" preserveAspectRatio="none"><path fill="#22242e" d="M0 0H1440V8Q720 22 0 14Z"></path></svg></div>

  <section class="steps-section" id="how-it-works"><div class="shell"><div class="steps-heading"><div><p class="eyebrow">How it works</p><h2>Set up separate variant galleries in four steps.</h2></div><p>A direct setup process using media already attached to your Shopify product.</p></div><ol class="steps-list"><li><span>1</span><h3>Select a product</h3><p>Open the product you want to organise inside VariantLens.</p></li><li><span>2</span><h3>Assign its media</h3><p>Drag the relevant images into each colour or style variant.</p></li><li><span>3</span><h3>Set the order</h3><p>Place the cover first and arrange the images that follow.</p></li><li><span>4</span><h3>Save and verify</h3><p>Open the published storefront and switch through every variant.</p></li></ol></div></section>

  <section class="plans-section"><div class="shell plans-grid"><div><p class="eyebrow">Start with one product</p><h2>Start with one product for free.</h2><p>The Free plan supports one active storefront product at a time, with no variant limit.</p></div><div class="plan-details"><div><span>Free</span><strong>$0</strong><small>One active storefront product</small></div><div><span>Standard</span><strong>$4.99 <small>/ month</small></strong><small>Use VariantLens across your catalogue</small></div><a class="button hide-button" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a href="/pricing/">Compare plans →</a></div></div></section>

  <section class="hide-faq"><div class="shell hide-faq__grid"><div><p class="eyebrow">Common questions</p><h2>Before you organise your galleries.</h2><p>Clear answers about assignment, image order and getting started.</p></div><FAQ items={faqs}/></div></section>

  <WaveDivider topColor="#f1f1f1" bottomColor="#20222b" />
  <section class="hide-cta"><div class="shell hide-cta__inner"><p class="eyebrow">Manual variant image control</p><h2>Keep other variant images out of the way.</h2><p>Start with one active storefront product and decide exactly what each variant should show.</p><a class="button hide-button hide-button--light" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a></div></section>
</BaseLayout>

<style>
  .hide-hero{min-height:760px;display:grid;align-items:center;padding:132px 0 92px;overflow:hidden;background:radial-gradient(circle at 76% 35%,rgba(156,166,218,.23),transparent 31%),#f7f6fb}.hide-hero__grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(470px,1.08fr);gap:76px;align-items:center}.hide-hero h1,.confusion-section h2,.focus-section h2,.control-section h2,.steps-section h2,.plans-section h2,.hide-faq h2,.hide-cta h2{margin:0;color:var(--ink);font-size:clamp(2.35rem,4.6vw,4.8rem);letter-spacing:-.06em;line-height:1.01}.hide-hero__copy>p:not(.eyebrow){max-width:620px;margin:25px 0 18px;color:#585b69;font-size:1.12rem}.hide-proof{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px}.hide-proof span{padding:5px 10px;border:1px solid rgba(98,112,175,.18);border-radius:999px;background:#fff;color:#343746;font-size:.7rem;font-weight:800;box-shadow:0 5px 13px rgba(55,62,97,.06)}.hide-actions{justify-content:flex-start}.hide-button{position:relative;isolation:isolate;overflow:hidden;contain:paint;border-width:2px;background:#6877b8;transform:translateZ(0);transition:color .22s ease,border-color .22s ease}.hide-button::before{content:"";position:absolute;z-index:0;inset:0;background:#fff;pointer-events:none;transform:translateY(102%);transition:transform .32s cubic-bezier(.22,1,.36,1)}.hide-button:hover,.hide-button:focus-visible{border-color:#fff;color:var(--ink);background:#6877b8}.hide-button:hover::before,.hide-button:focus-visible::before{transform:none}.hide-button span{position:relative;z-index:1}.hide-button--secondary{border-color:#bfc2ce;background:transparent;color:var(--ink)}.hide-button--secondary::before{background:#252733}.hide-button--secondary:hover,.hide-button--secondary:focus-visible{border-color:#252733;color:#fff;background:transparent}
  .gallery-comparison{width:100%}.gallery-comparison img{display:block;width:120%;max-width:none;height:auto;margin-left:-10%;filter:drop-shadow(0 24px 35px rgba(55,64,105,.12))}
  .confusion-section{padding:92px 0;background:#fff}.confusion-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:100px;align-items:center}.confusion-section h2{max-width:600px;font-size:clamp(1.9rem,2.7vw,2.85rem);letter-spacing:-.045em;line-height:1.08}.confusion-copy>p{max-width:660px;margin:0;color:var(--muted);font-size:1.05rem}
  .focus-section{padding:84px 0;background:#f1f1f1}.focus-grid{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:82px;align-items:center}.focus-section h2{font-size:clamp(2.25rem,3.8vw,3.8rem)}.focus-copy>p:not(.eyebrow){margin:22px 0;color:var(--muted)}.focus-copy a,.plan-details>a{color:var(--accent-dark);font-weight:800;text-underline-offset:4px}.variant-gallery-image img{display:block;width:100%;height:auto;filter:drop-shadow(0 20px 32px rgba(55,63,100,.1))}
  .control-curve{width:100%;height:24px;overflow:hidden;line-height:0}.control-curve svg{display:block;width:100%;height:100%}.control-curve--top{margin-bottom:-2px;background:#f1f1f1}.control-curve--bottom{margin-top:-2px;background:#fff}.control-section{padding:70px 0 76px;color:#fff;background:#22242e}.control-grid{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:90px}.control-section .eyebrow{color:#aeb8ed}.control-section h2{color:#fff;font-size:clamp(2.25rem,3.7vw,3.7rem)}.control-points{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(220,223,239,.18)}.control-points article{padding:24px 22px 8px 0}.control-points article+article{padding-left:22px;border-left:1px solid rgba(220,223,239,.14)}.control-points span{color:#9facdf;font-size:.7rem;font-weight:850}.control-points h3{margin:16px 0 8px;font-size:1.03rem}.control-points p{margin:0;color:#c6c8d1;font-size:.88rem}
  .steps-section{padding:92px 0;background:#fff}.steps-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.45fr);gap:70px;align-items:end;margin-bottom:38px}.steps-heading h2{max-width:750px;font-size:clamp(2.3rem,4vw,4rem)}.steps-heading>p{margin:0;color:var(--muted)}.steps-list{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:0;padding:0;list-style:none}.steps-list li{padding:24px 22px 26px;border-radius:12px;background:#fff;box-shadow:0 10px 25px rgba(45,50,78,.08);transition:transform .22s ease,box-shadow .22s ease}.steps-list li:hover{transform:translateY(-3px);box-shadow:0 15px 32px rgba(45,50,78,.13)}.steps-list span{display:grid;place-items:center;width:29px;height:29px;margin-bottom:22px;border:1px solid rgba(98,112,175,.4);border-radius:50%;color:var(--accent-dark);font-size:.72rem;font-weight:850}.steps-list h3{margin:0 0 7px;font-size:1rem}.steps-list p{margin:0;color:var(--muted);font-size:.84rem}
  .plans-section{padding:88px 0;background:#fff}.plans-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:88px;align-items:center}.plans-section h2{font-size:clamp(2.25rem,3.7vw,3.7rem)}.plans-grid>div:first-child>p:last-child{color:var(--muted)}.plan-details{display:grid;grid-template-columns:1fr 1fr;gap:13px}.plan-details>div{display:grid;gap:8px;padding:22px;border:1px solid #dbdde6;border-radius:12px;background:#f8f8fb}.plan-details>div>span{color:var(--accent-dark);font-size:.72rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.plan-details strong{font-size:2rem;letter-spacing:-.04em}.plan-details strong small{font-size:.8rem;color:var(--muted)}.plan-details>div>small{color:var(--muted)}.plan-details .button{justify-self:start;margin-top:4px}.plan-details>a:not(.button){align-self:center;justify-self:end}
  .hide-faq{padding:88px 0;background:#f1f1f1}.hide-faq__grid{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);gap:85px}.hide-faq h2{font-size:clamp(2.2rem,3.4vw,3.35rem)}.hide-faq__grid>div:first-child>p:last-child{max-width:340px;color:var(--muted)}
  .hide-cta{padding:92px 0;text-align:center;color:#fff;background:radial-gradient(circle at 50% 78%,rgba(114,129,194,.2),transparent 33%),#20222b}.hide-cta__inner{max-width:850px}.hide-cta .eyebrow{color:#aeb7e9}.hide-cta h2{color:#fff;font-size:clamp(2.45rem,4.4vw,4.4rem)}.hide-cta p{max-width:650px;margin:22px auto 29px;color:#d0d1d9}.hide-button--light{background:#fff;border-color:#fff;color:var(--ink)}.hide-button--light::before{background:#7885c1}.hide-button--light:hover,.hide-button--light:focus-visible{color:#fff;background:#fff;border-color:#7885c1}
  @media(max-width:920px){.hide-hero{min-height:0}.hide-hero__grid,.confusion-grid,.focus-grid,.control-grid,.plans-grid,.hide-faq__grid{grid-template-columns:1fr;gap:42px}.hide-hero__grid{gap:50px}.gallery-comparison{width:min(100%,760px);margin:auto}.control-points{grid-template-columns:repeat(3,1fr)}.steps-heading{grid-template-columns:1fr;gap:18px}}
  @media(max-width:640px){.hide-hero{padding:112px 0 68px}.hide-hero h1{font-size:clamp(2.5rem,12vw,3.65rem)}.hide-hero__copy>p:not(.eyebrow){font-size:1rem}.gallery-comparison img{width:108%;margin-left:-4%}.confusion-section,.focus-section,.control-section,.steps-section,.plans-section,.hide-faq{padding-block:65px}.confusion-section h2,.focus-section h2,.control-section h2,.steps-section h2,.plans-section h2{font-size:2.35rem}.control-points,.steps-list,.plan-details{grid-template-columns:1fr}.control-points article+article{padding-left:0;border-left:0;border-top:1px solid rgba(220,223,239,.14)}.steps-list li,.steps-list li+li{padding:22px}.hide-cta{padding-block:68px}.hide-actions{align-items:stretch;flex-direction:column}.hide-actions .button{width:100%}}
  @media(prefers-reduced-motion:reduce){.hide-button::before{transition-duration:.01ms}.steps-list li{transition:none}.steps-list li:hover{transform:none}}
</style>
