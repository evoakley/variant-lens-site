---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDivider from "../components/WaveDivider.astro";

const themes = ["Dawn", "Sense", "Horizon", "Flow", "Focal", "Reformation", "Impulse", "Pipeline", "Broadcast", "Atlantic", "Cascade", "Venue"];
const safetyPoints = [
  ["Safe detection", "Checks the product, variant and gallery structure before takeover."],
  ["Controlled takeover", "Hides the native gallery only after VariantLens is ready."],
  ["Safe fallback", "Keeps the native gallery available if compatibility checks fail."],
];
---

<BaseLayout
  title="VariantLens Shopify Theme Compatibility | Variant Image Support"
  description="Find out whether VariantLens works with your Shopify theme and how its variant image gallery supports selected variant images on your storefront."
  canonicalUrl="https://variantlens.app/theme-compatibility/"
  robots="index,follow"
>
  <header class="compatibility-hero">
    <div class="shell compatibility-hero__inner">
      <p class="eyebrow">VariantLens theme support</p>
      <h1>Does VariantLens Work With My Shopify Theme?</h1>
      <p>VariantLens controls the Shopify product image gallery so shoppers see only the images assigned to their selected variant. This page explains how the VariantLens variant image gallery works with Shopify themes, including tested themes and factors that can affect compatibility.</p>
    </div>
  </header>

  <section class="compatibility-section compatibility-section--white">
    <div class="shell compatibility-split">
      <div><p class="eyebrow">Gallery integration</p><h2>How VariantLens works with Shopify product galleries</h2></div>
      <div class="compatibility-copy">
        <p>VariantLens reads the product, variant and media information already available on the product page. When a shopper changes options, it updates the variant image gallery to show the images the merchant assigned to that selection.</p>
        <p>The result is a focused set of selected variant images instead of a gallery containing media for every colour or style. Learn more about <a href="/show-only-selected-variant-images-shopify/">showing only selected variant images</a>, <a href="/hide-other-variant-images-shopify/">hiding other variant images</a>, and managing <a href="/shopify-variant-images/">Shopify variant images</a>.</p>
      </div>
    </div>
  </section>
  <section class="compatibility-section compatibility-section--white">
    <div class="shell compatibility-known">
      <div class="compatibility-intro">
        <p class="eyebrow">Known compatibility</p>
        <h2>Shopify themes tested with VariantLens</h2>
        <p>These themes have known compatibility handling in VariantLens. Other standard Shopify themes may also work through VariantLens' generic compatibility layer, but a theme not listed here should not be assumed to have been tested.</p>
      </div>
      <ul class="theme-grid" aria-label="Known compatible Shopify themes">
        {themes.map((theme) => <li><span aria-hidden="true">&#10003;</span>{theme}</li>)}
      </ul>
    </div>
  </section>

  <WaveDivider topColor="#ffffff" bottomColor="#f1f1f1" />

  <section class="compatibility-section">
    <div class="shell compatibility-split">
      <div><p class="eyebrow">Broader support</p><h2>Can VariantLens support another Shopify theme?</h2></div>
      <div class="compatibility-copy">
        <p>VariantLens also includes a generic compatibility layer designed to safely recognise conventional Shopify product galleries.</p>
        <p>This means additional standard Shopify themes may work automatically even when they do not have a named compatibility adapter. Test the selected variant images on desktop and mobile before relying on the integration.</p>
      </div>
    </div>
  </section>

  <section class="compatibility-section compatibility-section--safety">
    <div class="shell">
      <div class="compatibility-intro compatibility-intro--center">
        <p class="eyebrow">Storefront safety</p>
        <h2>How VariantLens protects the product gallery</h2>
        <p>VariantLens only takes over the product gallery when it can do so confidently. If it cannot safely enhance the gallery, the theme's native gallery remains available rather than leaving the product page broken.</p>
      </div>
      <div class="safety-grid">
        {safetyPoints.map(([title, copy], index) => (
          <article class="safety-point"><span aria-hidden="true">0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>
        ))}
      </div>
    </div>
  </section>


  <section class="compatibility-section compatibility-section--white">
    <div class="shell compatibility-split">
      <div><p class="eyebrow">Compatibility issues</p><h2>What can affect VariantLens theme support?</h2></div>
      <div class="compatibility-copy">
        <p>Custom themes, third-party themes, heavily modified product galleries, custom variant selectors, and other apps that change product media can affect how VariantLens connects to a storefront.</p>
        <p>If the gallery does not update correctly, confirm that VariantLens is enabled, test a product with assigned variant images, and note the theme name and what happens when the selected variant changes. Send those details to support so we can review the setup.</p>
        <a class="compatibility-link" href="/support/">Contact VariantLens support <span aria-hidden="true">&#8594;</span></a>
      </div>
    </div>
  </section>

  <section class="compatibility-section compatibility-section--faq">
    <div class="shell compatibility-faq">
      <div class="compatibility-intro">
        <p class="eyebrow">VariantLens FAQ</p>
        <h2>Questions about VariantLens and Shopify themes</h2>
      </div>
      <div class="faq-list">
        <details><summary>Does VariantLens work with every Shopify theme?</summary><p>VariantLens has dedicated handling for the tested themes listed above and a generic compatibility layer for many conventional Shopify product galleries. Custom or substantially modified galleries may need additional support.</p></details>
        <details><summary>What happens if VariantLens cannot safely control my gallery?</summary><p>VariantLens keeps the theme's native product gallery available when its compatibility checks do not pass, rather than taking over a gallery it cannot confidently support.</p></details>
        <details><summary>Can another app affect my selected variant images?</summary><p>Yes. Apps or custom code that replace the product gallery, variant selector, or product media can conflict with VariantLens. Support can review the storefront setup if the variant image gallery is not responding as expected.</p></details>
        <details><summary>What should I send support if my theme is not working?</summary><p>Include the Shopify theme name, a product URL, the affected variant, the expected images, what you see instead, and whether the issue happens on desktop, mobile, or both.</p></details>
      </div>
    </div>
  </section>
  <WaveDivider topColor="#ffffff" bottomColor="#20212a" />

  <section class="compatibility-help">
    <div class="shell compatibility-help__inner">
      <div>
        <p class="eyebrow">VariantLens compatibility help</p><h2>Variant image gallery not working with your theme?</h2>
        <p>Tell us which Shopify theme you're using and what happens when a shopper selects a variant. We'll help determine whether additional VariantLens support is needed.</p>
      </div>
      <a class="button" href="/support/">Get VariantLens support</a>
    </div>
  </section>
</BaseLayout>

<style>
  .compatibility-hero{padding:142px 0 94px;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(circle at 84% 22%,rgba(98,112,175,.14),transparent 27%),#fff}
  .compatibility-hero__inner{max-width:900px;text-align:center}.compatibility-hero h1{max-width:780px;margin:0 auto;font-size:clamp(2.7rem,5.4vw,4.8rem);line-height:1.02;letter-spacing:-.06em}.compatibility-hero__inner>p:last-child{max-width:720px;margin:25px auto 0;color:var(--muted);font-size:1.12rem}
  .compatibility-section{padding:96px 0}.compatibility-section--white{background:#fff}.compatibility-section--safety{background:#e9eaf1}.compatibility-section--faq{background:#f7f7f9}
  .compatibility-known,.compatibility-split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(48px,8vw,110px);align-items:start}.compatibility-intro{max-width:540px}.compatibility-intro--center{max-width:760px;margin:0 auto;text-align:center}
  .compatibility-section h2,.compatibility-help h2{margin:0 0 20px;font-size:clamp(2.1rem,4vw,3.55rem);line-height:1.06;letter-spacing:-.05em}.compatibility-intro>p:last-child,.compatibility-copy p,.compatibility-help p{color:var(--muted);font-size:1.04rem}
  .theme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.theme-grid li{display:flex;align-items:center;gap:12px;min-height:58px;border-bottom:1px solid var(--line);font-weight:720}.theme-grid span{display:grid;width:23px;height:23px;place-items:center;border:1px solid rgba(98,112,175,.34);border-radius:50%;color:var(--accent-dark);font-size:.75rem}
  .compatibility-copy{max-width:610px}.compatibility-copy p:first-child{margin-top:4px}.safety-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:52px}.safety-point{padding-top:22px;border-top:2px solid rgba(98,112,175,.55)}.safety-point>span{color:var(--accent-dark);font-size:.72rem;font-weight:800;letter-spacing:.1em}.safety-point h3{margin:13px 0 8px;font-size:1.2rem}.safety-point p{margin:0;color:var(--muted)}
  .compatibility-link{display:inline-flex;gap:8px;margin-top:15px;color:var(--accent-dark);font-weight:780;text-decoration:none}.compatibility-link:hover{text-decoration:underline;text-underline-offset:4px}.compatibility-help{padding:74px 0;background:#20212a;color:#fff}.compatibility-help__inner{display:flex;align-items:center;justify-content:space-between;gap:54px}.compatibility-help__inner>div{max-width:690px}.compatibility-help h2{font-size:clamp(2rem,3.6vw,3rem)}.compatibility-help p{margin:0;color:#c8c9d1}.compatibility-help .eyebrow{color:#bfc6ed}.compatibility-help .button{flex:0 0 auto}
  .compatibility-copy a{color:var(--accent-dark);font-weight:700;text-underline-offset:3px}.compatibility-faq{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(48px,8vw,110px)}.faq-list{border-top:1px solid var(--line)}.faq-list details{border-bottom:1px solid var(--line)}.faq-list summary{padding:22px 36px 22px 0;cursor:pointer;font-size:1.06rem;font-weight:760}.faq-list p{margin:0;padding:0 0 24px;color:var(--muted)}
  @media(max-width:760px){.compatibility-hero{padding:105px 0 66px}.compatibility-hero__inner>p:last-child{font-size:1rem}.compatibility-section{padding:68px 0}.compatibility-known,.compatibility-split,.compatibility-faq{grid-template-columns:1fr;gap:36px}.theme-grid{gap:0 16px}.theme-grid li{min-height:54px;font-size:.94rem}.safety-grid{grid-template-columns:1fr;gap:26px;margin-top:38px}.compatibility-help__inner{align-items:flex-start;flex-direction:column;gap:28px}}
  @media(max-width:420px){.theme-grid{grid-template-columns:1fr}}
</style>
