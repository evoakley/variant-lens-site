---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import WaveDivider from "../components/WaveDivider.astro";

const title = "Shopify Variant Images by Color | VariantLens";
const description = "Assign different product images to each Shopify colour variant. VariantLens gives you manual control over colour-specific galleries, image order and cover images.";
const canonicalUrl = "https://variantlens.app/shopify-variant-images-by-color";
const faqs = [
  { question: "Can I assign different images to each Shopify colour variant?", answer: "Yes. VariantLens lets you manually choose which existing Shopify product images belong to each variant, including colour options." },
  { question: "Does VariantLens assign colour images automatically?", answer: "No. VariantLens is built around manual assignment so you can choose and verify exactly which images belong to each colour." },
  { question: "Can I control the order of the images?", answer: "Yes. You can arrange each variant gallery and use the first assigned image as the cover." },
  { question: "Can I use lifestyle and detail images for each colour?", answer: "Yes. You can assign any existing Shopify product media to the relevant variant, including product, lifestyle and detail images." },
  { question: "Can I test it on one product?", answer: "Yes. The Free plan supports one active storefront product at a time with no variant limit." },
  { question: "Do I need to edit my Shopify theme code?", answer: "No manual theme-code editing is required for normal installation." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
const colours = ["Blue", "Green", "Sand"];
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="colour-hero"><div class="shell colour-hero__grid">
    <div class="colour-hero__copy"><p class="eyebrow">Shopify colour variant images</p><h1>Give every Shopify colour variant its own images.</h1><p>Choose which product images belong to Blue, Green, Sand or any other colour option. VariantLens lets you build a separate gallery for each variant using the media already on your Shopify product.</p><div class="proof-pills" role="list"><span role="listitem">Manual control</span><span role="listitem">No coding</span><span role="listitem">Start free</span></div><div class="actions colour-actions"><a class="button colour-button" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a class="button secondary colour-button colour-button--secondary" href="#how-it-works"><span>See how it works</span></a></div></div>
    <div class="hero-gallery"><img src="/assets/brand/separate-variant-galleries.png" width="1688" height="941" alt="Separate image galleries for Blue, Green and Sand backpack variants" loading="eager" fetchpriority="high" decoding="async" /></div>
  </div></section>

  <section class="mixed-section"><div class="shell"><div class="section-heading section-heading--split"><div><p class="eyebrow">The colour variant problem</p><h2>One product gallery can mix every colour together.</h2></div><p>When several colour options share the same Shopify product media, shoppers can end up seeing Blue, Green, Sand and other colour images in one long gallery. Selecting a colour does not always make the rest disappear.</p></div><div class="mixed-gallery"><div class="selected-pill"><i></i>Blue selected</div><div class="mixed-track">{colours.concat(["Blue", "Sand", "Green", "Blue"]).map((colour, index) => <div class={`product-tile product-tile--${colour.toLowerCase()}`}><div class="bag"><i></i><b></b></div><small>{colour} {index % 3 === 0 ? "front" : index % 3 === 1 ? "angle" : "detail"}</small></div>)}</div><p>Blue selected. Other colours are still in the gallery.</p></div></div></section>

  <section class="result-section"><div class="shell result-grid"><div class="result-copy"><p class="eyebrow">A gallery for each colour</p><h2>Blue shows Blue. Green shows Green. Sand shows Sand.</h2><p>VariantLens lets you decide exactly which existing Shopify product media belongs to each colour option, so every selection can show a focused set of relevant images.</p><a href="/show-only-selected-variant-images-shopify">See how selected variant galleries work →</a></div><div class="colour-rows">{colours.map((colour) => <div class={`colour-row colour-row--${colour.toLowerCase()}`}><strong><i></i>{colour}</strong><div>{["Front", "Angle", "Detail"].map((label) => <span><b class="bag"><i></i></b><small>{label}</small></span>)}</div></div>)}</div></div></section>

  <section class="manual-section"><div class="shell manual-grid"><div><p class="eyebrow">Manual colour assignment</p><h2>Build each colour gallery exactly how you want it.</h2></div><div class="manual-points"><article><span>01</span><h3>Assign the images</h3><p>Choose which product images belong to each colour.</p></article><article><span>02</span><h3>Choose the cover</h3><p>The first assigned image becomes the variant cover.</p></article><article><span>03</span><h3>Arrange the sequence</h3><p>Control what shoppers see next.</p></article></div></div></section>

  <section class="steps-section" id="how-it-works"><div class="shell"><div class="section-heading section-heading--split"><div><p class="eyebrow">Four simple steps</p><h2>Set up colour-specific variant galleries in four steps.</h2></div><p>Use the product media already attached to your Shopify product.</p></div><ol class="steps-list"><li><span>01</span><h3>Select the product</h3><p>Choose a product with multiple colour variants and existing product images.</p></li><li><span>02</span><h3>Assign images by colour</h3><p>Drag the relevant product media into each colour variant.</p></li><li><span>03</span><h3>Set the gallery order</h3><p>Place the cover image first and arrange the remaining images.</p></li><li><span>04</span><h3>Save and verify</h3><p>Open the storefront and switch between colours to check the result.</p></li></ol></div></section>

  <section class="guessing-section"><div class="shell guessing-grid"><div><p class="eyebrow">No automatic guessing</p><h2>Your product photography does not always follow a predictable pattern.</h2><p>File names, upload order and image similarity are not always reliable ways to decide which media belongs to which colour. VariantLens keeps the decision with the merchant, so you can verify every assignment yourself.</p></div><ul><li>Choose the exact images yourself</li><li>Keep lifestyle and detail shots with the right colour</li><li>Control the cover image and gallery order</li></ul></div></section>

  <section class="pricing-section"><div class="shell pricing-grid"><div><p class="eyebrow">Start with one product</p><h2>Start with one product for free.</h2><p>The Free plan supports one active storefront product at a time with no variant limit. Upgrade when you want to use VariantLens across your catalogue.</p></div><div class="pricing-details"><article><span>Free</span><strong>$0</strong><p>One active storefront product</p><small>No variant limit</small></article><article class="pricing-standard"><span>Standard</span><strong>$4.99 <small>/ month</small></strong><p>Use VariantLens across your catalogue</p></article><div class="pricing-actions"><a class="button colour-button" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a href="/pricing">Compare plans →</a></div></div></div></section>

  <section class="faq-section"><div class="shell faq-grid"><div><p class="eyebrow">Common questions</p><h2>Questions about Shopify colour variant images</h2><p>Clear answers about assignment, image order and getting started.</p><a href="/hide-other-variant-images-shopify">Learn how to hide other variant images →</a></div><FAQ items={faqs} /></div></section>

  <WaveDivider topColor="#f1f1f1" bottomColor="#20222b" />
  <section class="final-cta"><div class="shell"><p class="eyebrow">Colour variant image control</p><h2>Give every colour the right gallery.</h2><p>Start with one active storefront product and choose exactly which images shoppers see for each colour variant.</p><a class="button colour-button colour-button--light" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a></div></section>
</BaseLayout>

<style>
  .colour-hero{min-height:750px;display:grid;align-items:center;padding:136px 0 92px;overflow:hidden;background:radial-gradient(circle at 76% 32%,rgba(134,151,220,.22),transparent 33%),#f7f6fb}.colour-hero__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(500px,1.1fr);gap:72px;align-items:center}.colour-hero h1,.section-heading h2,.result-section h2,.manual-section h2,.guessing-section h2,.pricing-section h2,.faq-section h2,.final-cta h2{margin:0;color:var(--ink);font-size:clamp(2.4rem,4.5vw,4.7rem);letter-spacing:-.06em;line-height:1.02}.colour-hero__copy>p:not(.eyebrow){max-width:650px;margin:25px 0 17px;color:#5b5e6c;font-size:1.08rem}.proof-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:31px}.proof-pills span{padding:6px 11px;border:1px solid rgba(98,112,175,.17);border-radius:999px;background:#fff;font-size:.72rem;font-weight:800;box-shadow:0 6px 15px rgba(55,62,97,.06)}.colour-actions{justify-content:flex-start}.hero-gallery img{display:block;width:115%;max-width:none;height:auto;margin-left:-7%;filter:drop-shadow(0 25px 42px rgba(57,67,111,.13))}
  .colour-button{position:relative;isolation:isolate;overflow:hidden;contain:paint;border-width:2px;background:#6877b8;transform:translateZ(0);transition:color .24s ease,border-color .24s ease}.colour-button::before{content:"";position:absolute;z-index:0;inset:0;background:#fff;pointer-events:none;transform:translateY(102%);transition:transform .34s cubic-bezier(.22,1,.36,1)}.colour-button:hover,.colour-button:focus-visible{border-color:#fff;color:var(--ink);background:#6877b8}.colour-button:hover::before,.colour-button:focus-visible::before{transform:none}.colour-button span{position:relative;z-index:1}.colour-button--secondary{border-color:#bfc2ce;background:transparent;color:var(--ink)}.colour-button--secondary::before{background:#252733}.colour-button--secondary:hover,.colour-button--secondary:focus-visible{border-color:#252733;color:#fff;background:transparent}
  .mixed-section{padding:90px 0;background:#fff}.section-heading--split{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.62fr);gap:78px;align-items:end;margin-bottom:42px}.section-heading h2{max-width:800px;font-size:clamp(2.35rem,3.8vw,3.9rem)}.section-heading--split>p{margin:0;color:var(--muted)}.mixed-gallery{padding:24px;border-radius:18px;background:#f4f5fa;box-shadow:inset 0 0 0 1px rgba(98,112,175,.15)}.selected-pill{display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;padding:7px 11px;border-radius:999px;color:#4053af;background:#fff;font-size:.74rem;font-weight:850;box-shadow:0 7px 18px rgba(65,75,120,.08)}.selected-pill i{width:9px;height:9px;border-radius:50%;background:#5264bd}.mixed-track{display:grid;grid-template-columns:repeat(7,minmax(120px,1fr));gap:10px;overflow-x:auto;padding-bottom:8px}.product-tile{min-width:120px;padding:14px 12px 10px;border:1px solid rgba(98,112,175,.13);border-radius:10px;background:#fff}.product-tile small{display:block;margin-top:8px;color:#616575;font-size:.68rem;font-weight:750}.bag{position:relative;display:block;width:58px;height:64px;margin:auto;border-radius:16px 16px 10px 10px;background:#6270af;box-shadow:inset 0 -16px 0 rgba(24,30,58,.08)}.bag::before{content:"";position:absolute;top:-8px;left:18px;width:20px;height:13px;border:5px solid currentColor;border-bottom:0;border-radius:10px 10px 0 0;color:#6c4b37}.bag i{position:absolute;top:13px;left:8px;width:42px;height:20px;border-radius:3px 3px 10px 10px;background:rgba(255,255,255,.13)}.bag b{position:absolute;top:22px;left:26px;width:6px;height:8px;border-radius:2px;background:#b88b60}.product-tile--green .bag,.colour-row--green .bag{background:#687452}.product-tile--sand .bag,.colour-row--sand .bag{background:#d8bd91}.mixed-gallery>p{margin:12px 0 0;color:#5e6374;font-size:.82rem;font-weight:750}
  .result-section{padding:90px 0;background:#f1f1f1}.result-grid{display:grid;grid-template-columns:minmax(0,.68fr) minmax(0,1.32fr);gap:82px;align-items:center}.result-section h2{font-size:clamp(2.35rem,3.7vw,3.8rem)}.result-copy>p:not(.eyebrow){margin:22px 0;color:var(--muted)}.result-copy>a,.faq-grid a,.pricing-actions>a:not(.button){color:var(--accent-dark);font-weight:800;text-underline-offset:4px}.colour-rows{display:grid;gap:12px}.colour-row{display:grid;grid-template-columns:105px 1fr;gap:15px;align-items:center;padding:13px;border-radius:13px;background:#fff;box-shadow:0 12px 28px rgba(54,62,96,.08)}.colour-row>strong{display:flex;align-items:center;gap:8px;padding-left:8px}.colour-row>strong i{width:11px;height:11px;border-radius:50%;background:#6270af}.colour-row--green>strong i{background:#687452}.colour-row--sand>strong i{background:#d8bd91}.colour-row>div{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.colour-row>div>span{display:grid;grid-template-columns:42px 1fr;align-items:center;gap:9px;padding:7px;border-radius:8px;background:#f6f6f9}.colour-row .bag{width:35px;height:38px;border-radius:9px 9px 6px 6px}.colour-row .bag::before{top:-5px;left:10px;width:11px;height:8px;border-width:3px}.colour-row .bag i{top:8px;left:5px;width:25px;height:12px}.colour-row small{color:#666a78;font-size:.65rem;font-weight:700}
  .manual-section{padding:88px 0;color:#fff;background:#22242e}.manual-grid{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:90px}.manual-section .eyebrow{color:#acb7ec}.manual-section h2{color:#fff;font-size:clamp(2.3rem,3.7vw,3.75rem)}.manual-points{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(220,223,239,.18)}.manual-points article{padding:24px 22px 8px 0}.manual-points article+article{padding-left:22px;border-left:1px solid rgba(220,223,239,.14)}.manual-points span{color:#9facdf;font-size:.7rem;font-weight:850}.manual-points h3{margin:16px 0 8px;font-size:1.03rem}.manual-points p{margin:0;color:#c6c8d1;font-size:.87rem}
  .steps-section{padding:92px 0;background:#fff}.steps-list{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:0;padding:0;list-style:none}.steps-list li{padding:24px 22px 27px;border-radius:12px;background:#fff;box-shadow:0 10px 25px rgba(45,50,78,.08);transition:transform .22s ease,box-shadow .22s ease}.steps-list li:hover{transform:translateY(-3px);box-shadow:0 15px 32px rgba(45,50,78,.13)}.steps-list span{display:grid;place-items:center;width:30px;height:30px;margin-bottom:22px;border:1px solid rgba(98,112,175,.4);border-radius:50%;color:var(--accent-dark);font-size:.69rem;font-weight:850}.steps-list h3{margin:0 0 7px;font-size:1rem}.steps-list p{margin:0;color:var(--muted);font-size:.84rem}
  .guessing-section{padding:88px 0;background:#f1f1f1}.guessing-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.75fr);gap:95px;align-items:center}.guessing-section h2{font-size:clamp(2.3rem,3.6vw,3.65rem)}.guessing-grid>div>p:last-child{color:var(--muted)}.guessing-grid ul{display:grid;gap:12px;margin:0;padding:0;list-style:none}.guessing-grid li{position:relative;padding:20px 20px 20px 52px;border-radius:10px;background:#fff;font-weight:800;box-shadow:0 10px 25px rgba(48,54,84,.07)}.guessing-grid li::before{content:"✓";position:absolute;left:20px;color:#6270af}
  .pricing-section{padding:90px 0;background:#fff}.pricing-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:90px;align-items:center}.pricing-section h2{font-size:clamp(2.3rem,3.7vw,3.75rem)}.pricing-grid>div:first-child>p:last-child{color:var(--muted)}.pricing-details{display:grid;grid-template-columns:1fr 1fr;gap:13px}.pricing-details article{display:grid;gap:7px;padding:23px;border:1px solid #dcdee7;border-radius:12px;background:#f8f8fb}.pricing-details article>span{color:var(--accent-dark);font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.09em}.pricing-details strong{font-size:2rem;letter-spacing:-.04em}.pricing-details strong small{color:var(--muted);font-size:.8rem}.pricing-details article p,.pricing-details article small{margin:0;color:var(--muted)}.pricing-standard{box-shadow:inset 0 3px 0 #6270af}.pricing-actions{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:5px}
  .faq-section{padding:90px 0;background:#f1f1f1}.faq-grid{display:grid;grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr);gap:86px}.faq-section h2{font-size:clamp(2.2rem,3.35vw,3.4rem)}.faq-grid>div:first-child>p:last-of-type{max-width:360px;color:var(--muted)}.faq-grid a{display:inline-block;margin-top:10px}.final-cta{padding:92px 0;text-align:center;color:#fff;background:radial-gradient(circle at 50% 80%,rgba(114,129,194,.2),transparent 34%),#20222b}.final-cta .shell{max-width:860px}.final-cta .eyebrow{color:#adb7e8}.final-cta h2{color:#fff;font-size:clamp(2.45rem,4.3vw,4.35rem)}.final-cta p{max-width:650px;margin:22px auto 29px;color:#d0d1d9}.colour-button--light{border-color:#fff;color:var(--ink);background:#fff}.colour-button--light::before{background:#7885c1}.colour-button--light:hover,.colour-button--light:focus-visible{border-color:#7885c1;color:#fff;background:#fff}
  @media(max-width:920px){.colour-hero{min-height:0}.colour-hero__grid,.result-grid,.manual-grid,.guessing-grid,.pricing-grid,.faq-grid{grid-template-columns:1fr;gap:44px}.colour-hero__grid{gap:50px}.hero-gallery{width:min(100%,760px);margin:auto}.section-heading--split{grid-template-columns:1fr;gap:18px}.manual-points{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:640px){.colour-hero{padding:112px 0 68px}.colour-hero h1{font-size:clamp(2.45rem,12vw,3.55rem)}.colour-hero__copy>p:not(.eyebrow){font-size:1rem}.hero-gallery img{width:110%;margin-left:-5%}.colour-actions{align-items:stretch;flex-direction:column}.colour-actions .button{width:100%}.mixed-section,.result-section,.manual-section,.steps-section,.guessing-section,.pricing-section,.faq-section{padding-block:65px}.section-heading h2,.result-section h2,.manual-section h2,.guessing-section h2,.pricing-section h2{font-size:2.3rem}.mixed-gallery{padding:16px}.mixed-track{grid-template-columns:repeat(7,112px)}.colour-row{grid-template-columns:1fr}.colour-row>div>span{grid-template-columns:33px 1fr}.manual-points,.steps-list,.pricing-details{grid-template-columns:1fr}.manual-points article+article{padding-left:0;border-left:0;border-top:1px solid rgba(220,223,239,.14)}.pricing-actions{align-items:stretch;flex-direction:column}.pricing-actions .button{width:100%}.final-cta{padding-block:68px}}
  @media(prefers-reduced-motion:reduce){.colour-button::before{transition-duration:.01ms}.steps-list li{transition:none}.steps-list li:hover{transform:none}}
</style>
