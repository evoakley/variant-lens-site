---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDivider from "../components/WaveDivider.astro";

const guides = [
  {
    href: "/show-only-selected-variant-images-shopify",
    mark: "01",
    title: "Show Only Selected Variant Images",
    description: "Show the product media that belongs to the variant a shopper selects."
  },
  {
    href: "/shopify-variant-images-by-color",
    mark: "02",
    title: "Variant Images by Colour",
    description: "Organise product media into clear colour-specific variant galleries."
  },
  {
    href: "/hide-other-variant-images-shopify",
    mark: "03",
    title: "Hide Other Variant Images",
    description: "Keep other colours and styles out of the current variant gallery."
  },
  {
    href: "/theme-compatibility/",
    mark: "04",
    title: "VariantLens Theme Compatibility",
    description: "Understand how VariantLens fits into a Shopify storefront theme."
  }
];

const themes = ["Dawn", "Horizon", "Sense"];
---

<BaseLayout
  title="VariantLens Guides - Shopify variant image control"
  description="Practical guides for creating cleaner Shopify product galleries and showing customers the right images for the variant they select."
  canonical="https://variantlens.app/guides"
>
  <div class="guides-page">
    <header class="guides-hero shell">
      <p class="eyebrow">VariantLens Guides</p>
      <h1>Shopify Variant Image Guides</h1>
      <p class="guides-hero__intro">Practical guides for creating cleaner product galleries and showing customers the right images for the variant they select.</p>
    </header>

    <section class="featured-section shell" aria-labelledby="featured-title">
      <a class="featured-guide" href="/shopify-variant-images/">
        <div class="guide-mark guide-mark--featured" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="featured-guide__content">
          <p class="card-kicker">Start here</p>
          <h2 id="featured-title">Shopify Variant Images</h2>
          <p>Learn how Shopify variant images work, common gallery problems, and how to show the right product images for each variant.</p>
        </div>
        <span class="guide-link">Read guide <span aria-hidden="true">&rarr;</span></span>
      </a>
    </section>

    <section class="guide-list-section shell" aria-labelledby="guide-list-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Explore the guides</p>
          <h2 id="guide-list-title">Clearer galleries start with the right setup.</h2>
        </div>
      </div>
      <div class="guide-grid">
        {guides.map((guide) => (
          <a class="guide-card" href={guide.href}>
            <div class="guide-card__top">
              <span class="guide-mark" aria-hidden="true">{guide.mark}</span>
              <span class="guide-card__arrow" aria-hidden="true">&rarr;</span>
            </div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <span class="guide-link">Read guide <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="theme-section shell" aria-labelledby="theme-title">
      <div class="theme-section__intro">
        <p class="eyebrow">Theme guides</p>
        <h2 id="theme-title">Guides by Shopify theme</h2>
        <p>Theme-specific guides for managing variant images across popular Shopify themes.</p>
      </div>
      <div class="theme-grid" aria-label="Shopify theme guides coming soon">
        {themes.map((theme) => (
          <div class="theme-card">
            <span class="theme-card__mark" aria-hidden="true">{theme.slice(0, 1)}</span>
            <span>{theme}</span>
            <small>Coming soon</small>
          </div>
        ))}
      </div>
    </section>

    <section class="guides-cta shell" aria-labelledby="guides-cta-title">
      <div>
        <p class="eyebrow">Manual control, made practical</p>
        <h2 id="guides-cta-title">Want an easier way to manage variant images?</h2>
        <p>VariantLens lets you manually control which product images appear for each variant.</p>
      </div>
      <a class="button guides-cta__button" href="https://apps.shopify.com/variantlens">View VariantLens on Shopify <span aria-hidden="true">&rarr;</span></a>
    </section>
    <WaveDivider topColor="#f8f8fb" bottomColor="#171820" />
  </div>
</BaseLayout>

<style>
  .guides-page { background: #f8f8fb; color: #171820; }
  .shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  .guides-hero { padding: clamp(124px, 16vw, 190px) 0 clamp(62px, 8vw, 92px); text-align: center; }
  .eyebrow, .card-kicker { margin: 0; color: #4d619d; font-size: .72rem; font-weight: 800; letter-spacing: .14em; line-height: 1.3; text-transform: uppercase; }
  .guides-hero h1 { max-width: 760px; margin: 20px auto 18px; font-size: clamp(2.8rem, 6vw, 5.15rem); letter-spacing: -.06em; line-height: .98; }
  .guides-hero__intro { max-width: 600px; margin: 0 auto; color: #66708a; font-size: clamp(1rem, 1.7vw, 1.16rem); line-height: 1.65; }
  .featured-section { padding-bottom: clamp(78px, 10vw, 126px); }
  .featured-guide { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(24px, 4vw, 52px); min-height: 232px; padding: clamp(28px, 4vw, 48px); border: 1px solid #e1e3ec; border-radius: 24px; background: #fff; box-shadow: 0 18px 48px rgba(32, 39, 70, .06); color: inherit; text-decoration: none; transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .featured-guide:hover, .featured-guide:focus-visible { border-color: #aeb9e4; box-shadow: 0 22px 54px rgba(32, 39, 70, .1); transform: translateY(-3px); }
  .featured-guide__content { max-width: 620px; }
  .featured-guide h2 { margin: 10px 0 12px; font-size: clamp(1.65rem, 3vw, 2.35rem); letter-spacing: -.045em; line-height: 1.05; }
  .featured-guide p:not(.card-kicker) { margin: 0; color: #66708a; line-height: 1.65; }
  .guide-mark { display: grid; width: 48px; height: 48px; place-items: center; flex: 0 0 auto; border: 1px solid #ccd4f1; border-radius: 14px; background: #f3f5ff; color: #5266a6; font-size: .78rem; font-weight: 800; letter-spacing: .05em; }
  .guide-mark--featured { position: relative; width: 74px; height: 74px; border-radius: 22px; overflow: hidden; }
  .guide-mark--featured span { position: absolute; display: block; width: 38px; height: 12px; border-radius: 999px; background: #687bc1; transform: rotate(-28deg); }
  .guide-mark--featured span:nth-child(1) { top: 19px; left: 12px; }
  .guide-mark--featured span:nth-child(2) { top: 32px; left: 24px; background: #96a3d7; }
  .guide-mark--featured span:nth-child(3) { top: 45px; left: 12px; background: #c2caea; }
  .guide-link { color: #4f63a4; font-size: .92rem; font-weight: 750; white-space: nowrap; }
  .guide-link span { display: inline-block; margin-left: 5px; transition: transform 180ms ease; }
  a:hover .guide-link span, a:focus-visible .guide-link span { transform: translateX(4px); }
  .guide-list-section { padding-bottom: clamp(90px, 12vw, 150px); }
  .section-heading { margin-bottom: 28px; }
  .section-heading h2 { max-width: 560px; margin: 9px 0 0; font-size: clamp(1.85rem, 3.5vw, 3rem); letter-spacing: -.05em; line-height: 1.02; }
  .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .guide-card { display: flex; min-height: 292px; flex-direction: column; padding: 24px; border: 1px solid #e1e3ec; border-radius: 18px; background: #fff; color: inherit; text-decoration: none; transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .guide-card:hover, .guide-card:focus-visible { border-color: #aeb9e4; box-shadow: 0 16px 38px rgba(32, 39, 70, .08); transform: translateY(-3px); }
  .guide-card__top { display: flex; align-items: center; justify-content: space-between; }
  .guide-card__arrow { color: #7384bd; font-size: 1.2rem; }
  .guide-card h3 { margin: 30px 0 10px; font-size: 1.28rem; letter-spacing: -.03em; line-height: 1.15; }
  .guide-card p { margin: 0; color: #66708a; line-height: 1.6; }
  .guide-card .guide-link { margin-top: auto; padding-top: 25px; }
  .theme-section { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(42px, 8vw, 120px); align-items: center; padding: clamp(46px, 6vw, 70px) clamp(28px, 5vw, 68px); border-radius: 24px; background: #eef0fa; }
  .theme-section h2 { margin: 10px 0 14px; font-size: clamp(1.8rem, 3vw, 2.65rem); letter-spacing: -.05em; line-height: 1.03; }
  .theme-section__intro > p:last-child { max-width: 430px; margin: 0; color: #66708a; line-height: 1.6; }
  .theme-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .theme-card { display: grid; min-height: 132px; align-content: center; justify-items: center; gap: 10px; border: 1px solid rgba(100, 116, 178, .2); border-radius: 16px; background: rgba(255, 255, 255, .65); color: #28304a; font-weight: 750; }
  .theme-card__mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: #dfe4f8; color: #566aa8; font-size: .85rem; }
  .theme-card small { color: #7c86a0; font-size: .7rem; font-weight: 600; }
  .guides-cta { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: clamp(90px, 12vw, 150px); padding-bottom: clamp(90px, 12vw, 150px); }
  .guides-cta h2 { max-width: 600px; margin: 10px 0 12px; font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.055em; line-height: 1; }
  .guides-cta p:last-child { max-width: 500px; margin: 0; color: #66708a; line-height: 1.6; }
  .guides-cta__button { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 9px; padding: 15px 21px; border-radius: 10px; background: #6c7cbd; color: #fff; font-weight: 750; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease; }
  .guides-cta__button:hover, .guides-cta__button:focus-visible { background: #5669aa; box-shadow: 0 12px 24px rgba(67, 81, 143, .2); transform: translateY(-2px); }
  @media (max-width: 850px) {
    .featured-guide { grid-template-columns: auto 1fr; }
    .featured-guide > .guide-link { grid-column: 2; }
    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .theme-section { grid-template-columns: 1fr; gap: 30px; }
    .guides-cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 560px) {
    .shell { width: min(100% - 32px, 1120px); }
    .guides-hero { padding-top: 96px; }
    .featured-guide { grid-template-columns: 1fr; gap: 22px; }
    .featured-guide > .guide-link { grid-column: auto; }
    .guide-grid, .theme-grid { grid-template-columns: 1fr; }
    .theme-card { min-height: 104px; }
  }
</style>
