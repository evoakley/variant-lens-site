---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="VariantLens support — Help with Shopify variant images" description="Get help with VariantLens installation, product image assignments, theme compatibility, or your subscription.">
  <header class="support-hero">
    <div class="shell support-hero__inner">
      <img src="/assets/brand/variantlens-mark.png" alt="" width="1200" height="1200" />
      <p class="eyebrow">VariantLens support</p>
      <h1>How can we help?</h1>
      <p>Get support with setup, assignments, storefront behaviour, theme compatibility, or billing.</p>
    </div>
  </header>

  <section class="support-section">
    <div class="shell support-layout">
      <article class="support-panel support-panel--contact">
        <p class="support-label">Contact support</p>
        <h2>Tell us what you're seeing.</h2>
        <p class="support-panel__lead">Send us the details below and we'll have the context needed to understand the issue.</p>

        <div class="email-card">
          <span class="email-card__label">Support email</span>
          <a href="mailto:support@variantlens.app">support@variantlens.app</a>
          <div class="email-actions">
            <button class="copy-email" type="button" data-copy-email="support@variantlens.app" aria-describedby="copy-email-status">Copy email</button>
            <a class="open-email" href="mailto:support@variantlens.app">Open email app</a>
          </div>
          <span class="copy-status" id="copy-email-status" aria-live="polite"></span>
        </div>

        <p class="include-title">Please include:</p>
        <ul class="include-list">
          <li>Your Shopify store domain</li>
          <li>The affected product URL</li>
          <li>Your theme name, if relevant</li>
          <li>A short description of the issue</li>
        </ul>
      </article>

      <article class="support-panel support-panel--checklist">
        <p class="support-label">Before contacting us</p>
        <h2>Four quick checks.</h2>
        <ul class="check-list">
          <li><span aria-hidden="true">✓</span><p>Confirm VariantLens is enabled in your current published theme.</p></li>
          <li><span aria-hidden="true">✓</span><p>Save your latest image assignments.</p></li>
          <li><span aria-hidden="true">✓</span><p>Open the affected product in a private browser window.</p></li>
          <li><span aria-hidden="true">✓</span><p>Include the theme name and product URL when reporting a gallery issue.</p></li>
        </ul>
      </article>

      <article class="support-panel support-panel--theme">
        <div>
          <p class="support-label">Theme compatibility</p>
          <h2>Need help with your theme?</h2>
          <p>VariantLens includes compatibility handling for popular Shopify themes and many standard gallery structures. If something doesn't look right, we can help review your setup.</p>
        </div>
        <a href="/theme-compatibility">View theme compatibility <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("#copy-email-status");

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.dataset.copyEmail;
    if (!email) return;

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(email);
      } else {
        const input = document.createElement("textarea");
        input.value = email;
        input.style.position = "fixed";
        input.style.opacity = "0";
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }

      copyButton.textContent = "Copied";
      if (copyStatus) copyStatus.textContent = "Support email copied to clipboard.";
      window.setTimeout(() => {
        copyButton.textContent = "Copy email";
        if (copyStatus) copyStatus.textContent = "";
      }, 1800);
    } catch {
      if (copyStatus) copyStatus.textContent = "Copy failed. Select the email address to copy it manually.";
    }
  });
</script>

<style>
  .support-hero { position: relative; overflow: hidden; padding: 132px 0 78px; border-bottom: 1px solid var(--line); background: #f8f7fc; text-align: center; }
  .support-hero::before { content: ""; position: absolute; inset: 0; opacity: .32; background-image: radial-gradient(circle, rgba(98,112,175,.24) .7px, transparent .9px); background-size: 17px 17px; mask-image: linear-gradient(to bottom, #000, transparent 82%); pointer-events: none; }
  .support-hero__inner { position: relative; max-width: 760px; }
  .support-hero img { display: block; width: 45px; height: 45px; margin: 0 auto 18px; object-fit: contain; }
  .support-hero h1 { margin: 0; font-size: clamp(2.75rem,5vw,4.5rem); line-height: 1.02; letter-spacing: -.06em; }
  .support-hero__inner>p:last-child { max-width: 650px; margin: 21px auto 0; color: var(--muted); font-size: 1.08rem; }

  .support-section { padding: 78px 0 96px; background: #fff; }
  .support-layout { display: grid; grid-template-columns: minmax(0,1.08fr) minmax(0,.92fr); gap: 18px; max-width: 1040px; }
  .support-panel { padding: 34px; border: 1px solid #dcdee6; border-radius: 13px; background: #fff; }
  .support-panel--contact { box-shadow: 0 18px 42px rgba(48,52,78,.08); }
  .support-label { margin: 0 0 13px; color: var(--accent-dark); font-size: .75rem; font-weight: 820; letter-spacing: .1em; text-transform: uppercase; }
  .support-panel h2 { margin: 0 0 13px; font-size: clamp(1.7rem,3vw,2.35rem); line-height: 1.08; letter-spacing: -.045em; }
  .support-panel__lead { max-width: 560px; margin: 0 0 25px; color: var(--muted); }

  .email-card { padding: 18px; border: 1px solid rgba(98,112,175,.25); border-radius: 9px; background: #f5f4fa; }
  .email-card__label { display: block; margin-bottom: 3px; color: var(--muted); font-size: .74rem; font-weight: 740; text-transform: uppercase; letter-spacing: .06em; }
  .email-card>a { display: inline-block; max-width: 100%; color: var(--ink); font-size: clamp(1rem,2.1vw,1.18rem); font-weight: 790; overflow-wrap: anywhere; }
  .email-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .copy-email,.open-email { display: inline-flex; min-height: 36px; align-items: center; justify-content: center; padding: 0 13px; border-radius: 7px; font: inherit; font-size: .8rem; font-weight: 760; cursor: pointer; text-decoration: none; }
  .copy-email { border: 1px solid var(--accent); background: var(--accent); color: #fff; transition: background .18s ease,border-color .18s ease; }
  .copy-email:hover { border-color: var(--accent-dark); background: var(--accent-dark); }
  .open-email { border: 1px solid #bfc1ca; background: #fff; color: var(--ink); }
  .open-email:hover { border-color: var(--accent); }
  .copy-email:focus-visible,.open-email:focus-visible,.support-panel--theme>a:focus-visible { outline: 3px solid rgba(98,112,175,.28); outline-offset: 2px; }
  .copy-status { display: block; min-height: 1.3em; margin-top: 8px; color: var(--accent-dark); font-size: .79rem; }

  .include-title { margin: 24px 0 8px; font-weight: 760; }
  .include-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px 24px; margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .91rem; }
  .include-list li::before { content: "—"; margin-right: 7px; color: var(--accent); }

  .support-panel--checklist { background: #f5f4fa; }
  .check-list { margin: 27px 0 0; padding: 0; list-style: none; border-top: 1px solid #d9dae2; }
  .check-list li { display: grid; grid-template-columns: 25px 1fr; gap: 12px; align-items: start; padding: 16px 0; border-bottom: 1px solid #d9dae2; }
  .check-list span { display: grid; width: 22px; height: 22px; place-items: center; margin-top: 1px; border: 1px solid rgba(98,112,175,.35); border-radius: 50%; color: var(--accent-dark); font-size: .72rem; font-weight: 800; }
  .check-list p { margin: 0; color: #4f515b; font-size: .93rem; }

  .support-panel--theme { grid-column: 1/-1; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; padding: 31px 34px; border-color: rgba(98,112,175,.27); background: #eeeff6; }
  .support-panel--theme>div { max-width: 700px; }
  .support-panel--theme h2 { font-size: clamp(1.65rem,2.8vw,2.2rem); }
  .support-panel--theme p:last-child { margin: 0; color: var(--muted); }
  .support-panel--theme>a { flex: 0 0 auto; color: var(--accent-dark); font-weight: 790; text-decoration: none; }
  .support-panel--theme>a:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media(max-width:760px){.support-hero{padding:103px 0 60px}.support-hero img{width:39px;height:39px}.support-section{padding:50px 0 68px}.support-layout{grid-template-columns:1fr}.support-panel{padding:25px 21px}.include-list{grid-template-columns:1fr}.support-panel--theme{grid-column:auto;align-items:flex-start;flex-direction:column;gap:24px}.support-panel--theme>a{flex:auto}.email-actions>*{flex:1 1 130px}}
</style>
