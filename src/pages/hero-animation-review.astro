---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroAnimated from "../components/HeroAnimated.astro";
import WaveDivider from "../components/WaveDivider.astro";
import CTA from "../components/CTA.astro";
import FAQSection from "../components/FAQSection.astro";
import ManualControlVisual from "../components/ManualControlVisual.astro";
import HowItWorks from "../components/HowItWorks.astro";

---
<BaseLayout
  title="Animated hero review | VariantLens"
  description="Experimental VariantLens hero animation review."
  robots="noindex, nofollow"
  headerVariant="floating"
>
  <HeroAnimated/>
  <HowItWorks />
  <WaveDivider topColor="#ffffff" bottomColor="#f1f1f1" />
  <section class="section divider-framed-section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Manual visual control</p>
        <h2>No guessing. No mismatched variant images.</h2>
        <p class="lead">You know your catalogue. VariantLens gives you a direct way to decide which images shoppers see for each variant.</p>
        <a href="/shopify-variant-images-by-color">Learn about colour variant images →</a>
      </div>
      <ManualControlVisual />
    </div>
  </section>
  <WaveDivider flipVertical flipHorizontal topColor="#ffffff" bottomColor="#f1f1f1" />
  <FAQSection />
  <CTA variant="homepage" />
  <aside class="review-status" aria-label="Experiment status">
    <div class="shell">
      <p><strong>Approved visual preview.</strong> The animated hero and floating navigation now match the main site.</p>
      <a href="/">Compare with the current homepage →</a>
    </div>
  </aside>
</BaseLayout>

<style>
  .divider-framed-section { padding-block: 62px; }
  .review-status { padding: 24px 0; background: #fff; border-bottom: 1px solid var(--line); }
  .review-status .shell { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .review-status p { margin: 0; color: var(--muted); }
  .review-status a { white-space: nowrap; }
  @media (max-width: 640px) {
    .divider-framed-section { padding-block: 46px; }
    .review-status .shell { align-items: flex-start; flex-direction: column; gap: 10px; }
  }
</style>
