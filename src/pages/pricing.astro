---
import BaseLayout from "../layouts/BaseLayout.astro";

const plans = [
  {
    name: "Free",
    price: "$0",
    cadence: "",
    description: "For trying VariantLens on a live product.",
    features: [
      "One active storefront product at a time",
    ],
    action: "Start free",
    featured: false,
  },
  {
    name: "Standard",
    price: "$4.99",
    cadence: "/ month",
    description: "For using VariantLens across your catalogue.",
    features: [
      "Use VariantLens across your catalogue",
    ],
    action: "Upgrade to Standard",
    featured: true,
  },
];
---
<BaseLayout
  title="VariantLens pricing — Free and Standard plans"
  description="Try VariantLens free on one active Shopify product, or use the Standard plan across your catalogue for $4.99 per month."
>
  <header class="pricing-hero">
    <div class="shell pricing-heading">
      <p class="eyebrow">Straightforward pricing</p>
      <h1>Try VariantLens on one product.<br />Upgrade when you need more.</h1>
      <p>Try VariantLens on one live product before upgrading.</p>
    </div>
  </header>

  <section class="pricing-section" aria-label="VariantLens plans">
    <div class="shell pricing-plans">
      {plans.map((plan) => (
        <article class:list={["pricing-plan", { "pricing-plan--featured": plan.featured }]}>
          <div class="pricing-plan__intro">
            <p class="pricing-plan__name">{plan.name}</p>
            <h2 class="pricing-plan__price">
              <span>{plan.price}</span>
              {plan.cadence && <small>{plan.cadence}</small>}
            </h2>
            <p class="pricing-plan__description">{plan.description}</p>
          </div>

          <ul class="pricing-plan__features">
            {plan.features.map((feature) => <li>{feature}</li>)}
          </ul>

          <a
            class:list={["pricing-plan__button", { "pricing-plan__button--featured": plan.featured }]}
            href="https://apps.shopify.com/variantlens"
            aria-label={`${plan.action} on the Shopify App Store`}
          >
            {plan.action}
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 132px 0 58px;
    background: #fff;
  }

  .pricing-heading > p:last-child { margin-top: 18px; }

  .pricing-section {
    position: relative;
    padding: 50px 0 86px;
    overflow: hidden;
    background: linear-gradient(to bottom, rgba(238, 237, 246, .52), rgba(241, 241, 241, 0) 52%);
  }

  .pricing-plans {
    position: relative;
    z-index: 1;
    max-width: 920px;
    gap: 18px;
  }

  .pricing-section .pricing-plan {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    padding: 30px;
    border-color: #d9dbe3;
    box-shadow: 0 10px 28px rgba(43, 47, 72, .045);
    transition: transform 230ms cubic-bezier(.22, 1, .36, 1), border-color 230ms ease, box-shadow 230ms ease, background-color 230ms ease;
  }

  .pricing-section .pricing-plan--featured {
    padding-top: 28px;
    border-color: rgba(98, 112, 175, .42);
    border-top: 3px solid var(--accent);
    box-shadow: 0 13px 34px rgba(72, 84, 143, .09);
  }

  .pricing-plan--featured::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 34%;
    height: 3px;
    background: rgba(224, 228, 255, .95);
    transform: translateX(-110%);
    animation: pricing-accent-travel 16s linear infinite;
    pointer-events: none;
  }

  .pricing-plan__price { min-height: 48px; }
  .pricing-plan__description { min-height: 48px; margin: 14px 0 20px; }
  .pricing-plan__features { margin-bottom: 24px; }

  .pricing-section .pricing-plan__button {
    min-height: 41px;
    transition: transform 190ms ease, background-color 190ms ease, border-color 190ms ease, color 190ms ease, box-shadow 190ms ease;
  }

  .pricing-plan__button:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: #f4f3fa;
  }

  .pricing-plan__button--featured:hover {
    border-color: var(--accent-dark);
    background: var(--accent-dark);
    color: #fff;
    box-shadow: 0 7px 18px rgba(70, 83, 143, .18);
  }

  .pricing-plan__button:active { transform: translateY(0); }

  .pricing-plan__button:focus-visible {
    outline: 3px solid rgba(98, 112, 175, .3);
    outline-offset: 3px;
  }

  @keyframes pricing-accent-travel {
    0%, 14% { transform: translateX(-110%); opacity: 0; }
    18% { opacity: .85; }
    48% { transform: translateX(295%); opacity: .85; }
    52%, 100% { transform: translateX(295%); opacity: 0; }
  }

  @media (hover: hover) and (pointer: fine) {
    .pricing-plan:hover {
      transform: translateY(-5px);
      border-color: #c9ccd7;
      background: #fdfdff;
      box-shadow: 0 18px 38px rgba(43, 47, 72, .09);
    }

    .pricing-plan--featured:hover {
      transform: translateY(-7px);
      border-color: rgba(98, 112, 175, .7);
      border-top-color: var(--accent);
      box-shadow: 0 20px 44px rgba(72, 84, 143, .16);
    }
  }

  @media (max-width: 900px) {
    .pricing-hero { padding-top: 120px; }
    .pricing-section .pricing-plan { padding: 26px; }
    .pricing-section .pricing-plan--featured { padding-top: 24px; }
  }

  @media (max-width: 760px) {
    .pricing-hero { padding: 101px 0 40px; }
    .pricing-section { padding: 38px 0 62px; }
    .pricing-section .pricing-plan { min-height: 0; padding: 24px; transform: none; }
    .pricing-section .pricing-plan--featured { padding-top: 22px; }
    .pricing-plan__description { min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-plan,
    .pricing-plan__button { transition-duration: .01ms !important; }
    .pricing-plan--featured::before { animation: none; opacity: 0; }
  }
</style>
