---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import ManualControlVisual from "../components/ManualControlVisual.astro";
import WaveDivider from "../components/WaveDivider.astro";

const title = "Show Only Selected Variant Images in Shopify | VariantLens";
const description = "Show only the images assigned to the selected Shopify variant. VariantLens gives you manual control over variant galleries, image order and cover images.";
const canonicalUrl = "https://variantlens.app/show-only-selected-variant-images-shopify";
const faqs = [
  { question: "Can Shopify show only the images for the selected variant?", answer: "Yes. VariantLens lets you manually assign existing Shopify product media to each variant, then shows the relevant gallery when a shopper changes their selection." },
  { question: "Does VariantLens assign variant images automatically?", answer: "No. You choose every assignment yourself, so the storefront result follows your catalogue decisions rather than an automated guess." },
  { question: "Can I control the order of images for each variant?", answer: "Yes. Images can be reordered within each variant, and the first assigned image becomes that variant's cover image." },
  { question: "Can I try this on one product first?", answer: "Yes. The Free plan supports one active storefront product at a time with no variant limit." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
};
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="solution-hero"><div class="shell solution-hero__grid">
    <div class="solution-hero__copy"><p class="eyebrow">Shopify variant image control</p><h1>Show only the images for the selected Shopify variant</h1><p>Give each colour or style its own gallery. You choose the images; shoppers see the right set for the variant they select.</p><div class="hero-accolades" role="list" aria-label="VariantLens benefits"><span role="listitem"><i aria-hidden="true">↔</i>Manual control</span><span role="listitem"><i aria-hidden="true">✓</i>No coding</span><span role="listitem"><i aria-hidden="true">✦</i>Start free</span></div><div class="actions actions--left"><a class="button cta-sweep" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a class="button secondary cta-sweep cta-sweep--secondary" href="#how-to"><span>See how it works</span></a></div></div>
    <div class="hero-product-visual" aria-hidden="true"><img src="/assets/brand/variantlens-product-gallery-hero.webp" alt="" width="1402" height="1122" loading="eager" fetchpriority="high" decoding="async"/></div>
  </div></section>
  <WaveDivider topColor="#f7f6fb" bottomColor="#ffffff" />

  <section class="narrative-section"><div class="shell narrative-panel">
    <div class="problem-intro"><div><p class="eyebrow">The problem</p><h2>One long gallery can make every variant harder to understand.</h2></div><p>Shopify products often keep multiple colour or style images in one gallery, so even after a shopper selects a variant, unrelated images can make that selection less clear.</p></div>
    <div class="clutter-gallery" aria-label="Slate is selected, but a long gallery still includes unrelated product images">
      <div class="clutter-gallery__topline"><span><i aria-hidden="true">✓</i> Slate selected</span><p>Selected Slate. Still scrolling through everything.</p></div>
      <div class="clutter-gallery__viewport">
        <div class="clutter-gallery__rail" aria-label="Mixed gallery containing Slate, lifestyle, Tortoise Shell and Cobalt images">
          <span class="clutter-thumb clutter-thumb--slate-front"></span>
          <span class="clutter-thumb clutter-thumb--slate-side"></span>
          <span class="clutter-thumb clutter-thumb--slate-detail"></span>
          <span class="clutter-thumb clutter-thumb--lifestyle"><b>Lifestyle still visible</b></span>
          <span class="clutter-thumb clutter-thumb--tortoise"><b>Tortoise still visible</b></span>
          <span class="clutter-thumb clutter-thumb--cobalt"><b>Cobalt still visible</b></span>
          <span class="clutter-thumb clutter-thumb--detail"></span>
          <span class="clutter-thumb clutter-thumb--slate-front"></span>
          <span class="clutter-thumb clutter-thumb--tortoise"></span>
        </div>
      </div>
    </div>
  </div></section>

  <section class="product-section"><div class="shell"><div class="product-section__heading"><p class="eyebrow">How VariantLens works</p><h2>How VariantLens gives each variant its own gallery</h2></div><div class="product-grid"><ManualControlVisual cycle={true} /><ol class="product-callouts"><li><span>01</span><div><h3>Assign images</h3><p>Use media already attached to the Shopify product.</p></div></li><li><span>02</span><div><h3>Arrange each gallery</h3><p>Choose the order and cover image for each variant.</p></div></li><li><span>03</span><div><h3>Save and verify</h3><p>Open the storefront and switch variants to check the result.</p></div></li></ol></div></div></section>

  <section class="manual-band"><div class="shell manual-band__inner"><div><p class="eyebrow">Manual visual control</p><h2>You decide which images belong to each variant.</h2></div><div><p>VariantLens uses your existing Shopify product media. Nothing is automatically guessed, so you retain control over every assignment and gallery order.</p><ul><li>Choose each image</li><li>Control gallery order</li><li>Verify the result yourself</li></ul><a href="/shopify-variant-images-by-color">Read the colour variant image guide →</a></div></div></section>

  <WaveDivider topColor="#ffffff" bottomColor="#f1f1f1" />
  <section class="how-to-section" id="how-to"><div class="shell"><div class="how-to-heading"><p class="eyebrow">Five practical steps</p><h2>How to show only selected variant images in Shopify</h2><p>The direct setup process, from installation to storefront verification.</p></div><ol class="how-to-list"><li><span>1</span><div><h3>Install VariantLens</h3><p>Enable the app embed on your published Shopify theme.</p></div></li><li><span>2</span><div><h3>Select the product</h3><p>Choose the product whose gallery contains multiple variants.</p></div></li><li><span>3</span><div><h3>Assign the images</h3><p>Drag the relevant product media into each colour or style.</p></div></li><li><span>4</span><div><h3>Set the order</h3><p>Place the intended cover first and arrange the images that follow.</p></div></li><li><span>5</span><div><h3>Save and verify</h3><p>Open the storefront and test every variant selection.</p></div></li></ol></div></section>
  <WaveDivider flipVertical flipHorizontal topColor="#ffffff" bottomColor="#f1f1f1" />

  <section class="faq-section"><div class="shell faq-grid"><div><p class="eyebrow">Common questions</p><h2>Questions about variant images</h2><p>Straight answers about image assignment, gallery order and getting started.</p></div><FAQ items={faqs}/></div></section>

  <section class="solution-cta"><div class="shell solution-cta__inner">
    <div class="solution-cta__copy"><p class="eyebrow">Start with one product</p><h2>Give every variant the right gallery.</h2><p>Try VariantLens free on one active storefront product. Use your existing Shopify product media, choose exactly which images belong to each variant, and verify the result on your storefront.</p><div class="solution-cta__proof" role="list" aria-label="VariantLens benefits"><span role="listitem">Manual control</span><span role="listitem">No coding</span><span role="listitem">Start free</span></div><div class="solution-cta__actions"><a class="button cta-sweep" href="https://apps.shopify.com/variantlens"><span>Install on Shopify</span></a><a class="button solution-cta__secondary" href="/pricing">Compare plans</a></div></div>
    <aside class="solution-cta__summary" aria-label="What is included when starting free"><p>Start free</p><ul><li>One active storefront product</li><li>No variant limit</li><li>Use existing Shopify product media</li></ul><div aria-label="VariantLens setup sequence"><span>Assign</span><i aria-hidden="true">→</i><span>Save</span><i aria-hidden="true">→</i><span>Verify</span></div></aside>
  </div></section>
</BaseLayout>

<style>
  .solution-hero{min-height:100svh;display:grid;align-items:center;overflow:hidden;border:0;background:#f7f6fb}.solution-hero__grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(470px,1.05fr);align-items:center;gap:52px;padding:145px 0}.solution-hero__copy{position:relative;z-index:2}.solution-hero h1{max-width:650px;margin:0;font-size:clamp(2.25rem,3.5vw,3.55rem);letter-spacing:-.055em;line-height:1.02}.solution-hero__copy>p:not(.eyebrow){max-width:650px;margin:24px 0 14px;color:var(--muted);font-size:1.14rem}.actions--left{justify-content:flex-start}.hero-accolades{display:flex;flex-flow:row nowrap;align-items:center;gap:8px;margin:0 0 40px}.hero-accolades>span{display:inline-flex;align-items:center;gap:6px;min-height:28px;padding:4px 10px;border:1px solid rgba(98,112,175,.12);border-radius:999px;color:#292733;background:#fff;font-size:.7rem;font-weight:700;line-height:1;white-space:nowrap;box-shadow:0 5px 14px rgba(55,62,97,.08)}.hero-accolades i{display:grid;place-items:center;width:14px;height:14px;border:1px solid rgba(98,112,175,.42);border-radius:50%;color:var(--accent-dark);font-size:.55rem;font-style:normal;line-height:1}.hero-product-visual{position:relative;justify-self:end;width:min(112%,680px);overflow:hidden;border-radius:22px;box-shadow:0 24px 55px rgba(55,62,97,.14);transform:translateY(8px)}.hero-product-visual img{display:block;width:100%;height:auto}
  .cta-sweep{position:relative;isolation:isolate;overflow:hidden;contain:paint;border-width:2px;background:#6b79b9;color:#fff;transform:translateZ(0);backface-visibility:hidden;transition:color 220ms ease,border-color 220ms ease}.cta-sweep::before{content:"";position:absolute;z-index:0;inset:0;background:#fff;pointer-events:none;transform:translateY(102%);transition:transform 320ms cubic-bezier(.22,1,.36,1)}.cta-sweep:hover,.cta-sweep:focus-visible{border-color:#fff;background:#6b79b9;color:var(--ink)}.cta-sweep:hover::before,.cta-sweep:focus-visible::before{transform:translateY(0)}.cta-sweep span{position:relative;z-index:1}.cta-sweep--secondary{border-width:3px;background:transparent;color:var(--ink)}.cta-sweep--secondary::before{background:#252733}.cta-sweep--secondary:hover,.cta-sweep--secondary:focus-visible{border-color:#252733;background:transparent;color:#fff}
  .narrative-section{padding:74px 0;background:#fff}.narrative-panel{padding:48px;border:1px solid rgba(98,112,175,.2);border-radius:20px;background:#f5f5fa}.problem-intro{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:70px;align-items:end;margin-bottom:38px}.problem-intro h2,.product-section h2,.manual-band h2,.how-to-section h2,.faq-section h2,.solution-cta h2{margin:0;font-size:clamp(2rem,3.5vw,3.25rem);letter-spacing:-.05em;line-height:1.05}.problem-intro>p{margin:0;color:var(--muted);font-size:1.03rem}.gallery-comparison{display:grid;grid-template-columns:minmax(0,1fr) 54px minmax(0,1fr);align-items:stretch}.gallery-state{padding:25px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.82)}.gallery-state--after{border-color:rgba(98,112,175,.48);background:#fff;box-shadow:0 18px 42px rgba(70,83,143,.08)}.gallery-state header{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:18px}.gallery-state header span{color:var(--accent-dark);font-size:.68rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.gallery-state h3{margin:2px 0 0;font-size:1.06rem}.gallery-state header>small{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:.72rem}.gallery-state header>small i{width:9px;height:9px;border-radius:50%;background:#3f4d7d}.concept-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.concept-gallery--focused{grid-template-columns:repeat(3,1fr)}.concept-image{position:relative;min-height:138px;overflow:hidden;border:1px solid #dde0eb;border-radius:8px;background:#edf0f8}.concept-image i{position:absolute;width:46%;height:52%;left:27%;top:19%;border-radius:34% 34% 16% 16%;background:#59679e}.concept-image i::before,.concept-image i::after{content:"";position:absolute;width:28%;height:44%;top:8%;border-radius:50% 50% 20% 20%;background:inherit}.concept-image i::before{left:-18%;transform:rotate(20deg)}.concept-image i::after{right:-18%;transform:rotate(-20deg)}.concept-image b{position:absolute;left:8px;bottom:6px;color:#565c75;font-size:.58rem}.concept-image--stone{background:#f0ede8}.concept-image--stone i{background:#aaa195}.concept-image--plum{background:#f1eaf0}.concept-image--plum i{background:#8c6681}.concept-image--navy-light i{background:#7180b3}.concept-image--navy-dark i{background:#3f4d7d}.gallery-state>p{margin:16px 0 0;color:var(--muted);font-size:.86rem}.comparison-arrow{display:grid;place-items:center}.comparison-arrow span{display:grid;place-items:center;width:32px;height:32px;border:1px solid rgba(98,112,175,.28);border-radius:50%;color:var(--accent);background:#fff}
  .product-section{padding:78px 0 72px;background:#f1f1f1}.product-section__heading{margin-bottom:34px}.product-section__heading h2{max-width:690px}.product-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.5fr);gap:36px;align-items:stretch}.product-grid>:first-child{min-height:330px}.product-callouts{margin:0;padding:0;list-style:none;border-top:1px solid #d5d6df}.product-callouts li{display:grid;grid-template-columns:34px 1fr;gap:13px;padding:21px 0;border-bottom:1px solid #d5d6df}.product-callouts span{color:var(--accent);font-size:.7rem;font-weight:850;letter-spacing:.08em}.product-callouts h3{margin:0 0 5px;font-size:1rem}.product-callouts p{margin:0;color:var(--muted);font-size:.89rem;line-height:1.5}
  .manual-band{padding:54px 0;background:#fff}.manual-band__inner{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:72px;align-items:center;padding:34px 38px;border-left:3px solid var(--accent);background:#f7f6fb}.manual-band h2{font-size:clamp(1.9rem,3vw,2.7rem)}.manual-band__inner>div:last-child>p{margin:0 0 15px;color:var(--muted)}.manual-band ul{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 16px;padding:0;list-style:none}.manual-band li{padding:6px 10px;border:1px solid rgba(98,112,175,.2);border-radius:6px;color:#4f577d;background:#fff;font-size:.76rem;font-weight:750}.manual-band a,.pricing-link{color:var(--accent-dark);font-weight:750;text-decoration-thickness:1px;text-underline-offset:4px}
  .how-to-section{padding:76px 0;background:#f1f1f1}.how-to-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.45fr);column-gap:65px;align-items:end;margin-bottom:34px}.how-to-heading .eyebrow,.how-to-heading h2{grid-column:1}.how-to-heading h2{max-width:760px}.how-to-heading>p:last-child{grid-column:2;grid-row:1/3;margin:0;color:var(--muted)}.how-to-list{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none;border-top:1px solid #d0d2dc;border-bottom:1px solid #d0d2dc}.how-to-list li{min-width:0;padding:22px 20px 23px 0}.how-to-list li+li{padding-left:20px;border-left:1px solid #d7d8e0}.how-to-list span{display:grid;place-items:center;width:28px;height:28px;margin-bottom:20px;border:1px solid rgba(98,112,175,.4);border-radius:50%;color:var(--accent-dark);background:transparent;font-size:.72rem;font-weight:850;transition:color .22s ease,background-color .22s ease,border-color .22s ease,transform .22s ease,box-shadow .22s ease}.how-to-list li:hover span{border-color:var(--accent);color:#fff;background:var(--accent);transform:translateY(-2px) scale(1.08);box-shadow:0 7px 16px rgba(98,112,175,.22)}.how-to-list h3{margin:0 0 7px;font-size:.94rem}.how-to-list p{margin:0;color:var(--muted);font-size:.82rem;line-height:1.5}
  .faq-section{padding:70px 0 62px;background:#fff}.faq-grid{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);gap:80px}.faq-section h2{font-size:clamp(2rem,3.2vw,3rem)}.faq-section .faq-grid>div:first-child>p:last-child{max-width:350px;color:var(--muted)}
  .solution-cta{position:relative;overflow:hidden;padding:92px 0 94px;color:#fff;border-bottom:1px solid rgba(208,212,238,.12);background:radial-gradient(circle at 76% 48%,rgba(118,132,198,.2),transparent 34%),linear-gradient(135deg,#242631 0%,#1d1e27 72%)}.solution-cta::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 0 58%,rgba(188,195,234,.035) 58% 59%,transparent 59%)}.solution-cta__inner{position:relative;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(310px,.68fr);gap:84px;align-items:center}.solution-cta__copy{max-width:720px}.solution-cta .eyebrow{color:#b8c0ec}.solution-cta h2{max-width:660px;color:#fff;font-size:clamp(2.35rem,4vw,4rem)}.solution-cta__copy>p:not(.eyebrow){max-width:680px;margin:22px 0 24px;color:#d2d3dc;font-size:1rem;line-height:1.7}.solution-cta__proof{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:30px}.solution-cta__proof span{padding:6px 10px;border:1px solid rgba(190,198,237,.2);border-radius:999px;color:#e2e4ef;background:rgba(255,255,255,.045);font-size:.72rem;font-weight:750}.solution-cta__actions{display:flex;align-items:center;gap:12px}.solution-cta__secondary{border-color:rgba(219,222,239,.44);color:#f3f3f7;background:transparent}.solution-cta__secondary:hover,.solution-cta__secondary:focus-visible{border-color:#fff;background:rgba(255,255,255,.08)}.solution-cta__summary{padding:29px 30px;border:1px solid rgba(193,200,237,.22);border-radius:14px;background:rgba(255,255,255,.055);box-shadow:0 28px 70px rgba(7,8,13,.22)}.solution-cta__summary>p{margin:0 0 19px;color:#bdc5ef;font-size:.72rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.solution-cta__summary ul{display:grid;gap:13px;margin:0;padding:0 0 24px;list-style:none;border-bottom:1px solid rgba(208,212,238,.15)}.solution-cta__summary li{position:relative;padding-left:19px;color:#f1f1f5;font-size:.89rem}.solution-cta__summary li::before{content:"";position:absolute;left:0;top:.55em;width:7px;height:7px;border:1px solid #aab5ec;border-radius:50%;background:#6675b7}.solution-cta__summary>div{display:flex;align-items:center;justify-content:space-between;gap:9px;padding-top:20px;color:#dfe2f4;font-size:.72rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.solution-cta__summary i{color:#8795d3;font-size:.85rem;font-style:normal}
