---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import FAQSection from "../components/FAQSection.astro";
import HeroAnimated from "../components/HeroAnimated.astro";
import WaveDivider from "../components/WaveDivider.astro";
import ManualControlVisual from "../components/ManualControlVisual.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CommercialOutcomes from "../components/CommercialOutcomes.astro";

---
<BaseLayout title="VariantLens — Show the right Shopify images for every variant" description="Manually assign Shopify product images to variants so shoppers see only the images relevant to their selected colour or style.">
  <HeroAnimated />
  <HowItWorks />
  <CommercialOutcomes />
  <WaveDivider topColor="#20212a" bottomColor="#f1f1f1" />
  <section class="section divider-framed-section"><div class="shell split"><div><p class="eyebrow">Manual visual control</p><h2>No guessing. No mismatched variant images.</h2><p class="lead">You know your catalogue. VariantLens gives you a direct way to decide which images shoppers see for each variant.</p><a href="/show-only-selected-variant-images-shopify/">Learn how to show only selected variant images →</a></div><ManualControlVisual /></div></section>
  <WaveDivider flipVertical flipHorizontal topColor="#ffffff" bottomColor="#f1f1f1" />
  <FAQSection />
  <CTA variant="homepage" />
</BaseLayout>

<style>
  .divider-framed-section { padding-block: 62px; }

  @media (max-width: 640px) {
    .divider-framed-section { padding-block: 46px; }
  }
</style>
